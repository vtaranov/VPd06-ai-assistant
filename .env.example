# Ключ из https://console.proxyapi.ru/keys
PROXYAPI_KEY=your_proxyapi_key_here

# Все модели в ProxyAPI надёжнее указывать в формате вендор/модель.
NORMAL_MODEL=openai/gpt-6-luna
THINKING_MODEL=anthropic/claude-opus-5-5
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1

SYSTEM_PROMPT=Ты полезный ассистент. Отвечай на русском языке.
REQUEST_TIMEOUT_SECONDS=60
MAX_OUTPUT_TOKENS=1200
MAX_HISTORY_MESSAGES=20
HISTORY_FILE=history.json
LOG_LEVEL=INFO

